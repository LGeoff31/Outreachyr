FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/outreachyr-venv

WORKDIR /workspace/backend

COPY backend/pyproject.toml backend/uv.lock ./
RUN uv sync --frozen --no-cache
COPY backend/ ./

CMD ["sh", "-c", "uv run uvicorn app:app --host 0.0.0.0 --port ${BACKEND_PORT:?Set BACKEND_PORT} --reload"]
