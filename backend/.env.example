# SerpAPI key used to search Google results for LinkedIn recruiter profiles (https://serpapi.com/)
SERPAPI_API_KEY=your_serpapi_api_key_here

# Send mail via Sign in with Google (Gmail API). Supabase Auth handles login,
# but the backend still uses this OAuth client to refresh Gmail provider tokens.
# IMPORTANT: Use the SAME Google OAuth client ID + secret in Supabase Auth
# (Authentication → Providers → Google) and here on the backend/Vercel.
# In Supabase, add this additional scope: https://www.googleapis.com/auth/gmail.send
# Create an OAuth "Web application" client at https://console.cloud.google.com/apis/credentials
# and enable Gmail API for the project.
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret

# Optional: random delay (seconds) before the first Gmail send, between messages,
# and extra pause after each small batch. Use min,max — defaults are 0s before
# the first send, 22–48s between sends, 50–100s pause after every 2–4 emails.
# GMAIL_SEND_INITIAL_DELAY_SEC=0,0
# GMAIL_SEND_SPACING_SEC=22,48
# GMAIL_SEND_CHUNK_PAUSE_SEC=50,100

# Stripe — one-time $5 campaign unlock (optional in local dev; billing skipped if unset)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Comma-separated emails that bypass the campaign paywall (default: geoffrey31415@gmail.com)
# BILLING_ADMIN_EMAILS=geoffrey31415@gmail.com

# FRONTEND_URL=http://localhost:3000
# FRONTEND_ORIGIN=http://localhost:3000

# Supabase Auth settings used to validate the frontend session before storing
# the Gmail provider refresh token. In local dev, the backend also loads
# frontend/.env if these are not set here.
SUPABASE_URL=https://your_project_ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_or_anon_key

# Supabase Postgres connection string for SQLAlchemy.
# Prefer the session pooler for a persistent FastAPI server if direct IPv6 is not available.
DATABASE_URL=postgresql+psycopg://postgres.your_project_ref:your_password@aws-0-your-region.pooler.supabase.com:5432/postgres
