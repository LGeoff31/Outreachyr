# Local Docker ports
BACKEND_PORT=5050
FRONTEND_PORT=3000

# Local Supabase
# `npm run dev` starts the Supabase CLI stack and derives these runtime values
# from `supabase status -o env` without editing `.env`.
# Keep the values below for direct `docker compose ...` runs or remote Supabase.
SUPABASE_URL=https://your_project_ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_or_anon_key
# Docker-side hostname for local Supabase. Override only if your Docker runtime
# cannot reach services on the host through host.docker.internal.
SUPABASE_INTERNAL_HOST=host.docker.internal
# `npm run dev` derives SUPABASE_SERVER_URL for Next server-side Supabase calls.
# Set this only for direct Docker Compose runs when it differs from SUPABASE_URL.
# SUPABASE_SERVER_URL=

# Supabase Postgres connection string for SQLAlchemy.
# Prefer the session pooler for a persistent FastAPI server if direct IPv6 is not available.
# Add the database password in your private .env when using a remote Supabase database.
DATABASE_URL=postgresql+psycopg://postgres.your_project_ref@aws-0-your-region.pooler.supabase.com:5432/postgres

# SerpAPI key used to search Google results for LinkedIn recruiter profiles.
SERPAPI_API_KEY=your_serpapi_api_key_here

# Google identity login is configured in Supabase Auth with this OAuth client.
# Existing Gmail grants created before mail connections also keep using it.
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret

# Provider-neutral sending-account credential vault. Generate the key with:
# python -c 'from cryptography.fernet import Fernet; print("v1:" + Fernet.generate_key().decode())'
MAILBOX_CREDENTIAL_KEYS=v1:replace_with_a_generated_fernet_key

# Optional dedicated Google OAuth client for Gmail consent. If omitted, the
# identity-login client above is reused. Register GOOGLE_MAIL_REDIRECT_URI as an
# authorized redirect URI on whichever client is used.
GOOGLE_MAIL_CLIENT_ID=
GOOGLE_MAIL_CLIENT_SECRET=
GOOGLE_MAIL_REDIRECT_URI=http://localhost:3000/api/mail-connections/google/callback

# Contact and feedback email.
NEXT_PUBLIC_CONTACT_EMAIL=
RESEND_API_KEY=
RESEND_FROM=Outreachyr <onboarding@resend.dev>

# Stripe one-time campaign unlock. Leave blank in local dev to skip billing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BILLING_ADMIN_EMAILS=geoffrey31415@gmail.com

# Optional direct-run overrides. Docker Compose derives its own internal
# OUTREACH_API_URL, FRONTEND_URL, FRONTEND_ORIGIN, and Supabase Auth callback
# values from the ports and Supabase CLI status output above.
# PUBLIC_APP_URL=
# OUTREACH_API_URL=
