# Local Docker ports
BACKEND_PORT=5050
FRONTEND_PORT=3000

# Supabase Auth
SUPABASE_URL=https://your_project_ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_or_anon_key

# Supabase Postgres connection string for SQLAlchemy.
# Prefer the session pooler for a persistent FastAPI server if direct IPv6 is not available.
DATABASE_URL=postgresql+psycopg://postgres.your_project_ref:your_password@aws-0-your-region.pooler.supabase.com:5432/postgres

# SerpAPI key used to search Google results for LinkedIn recruiter profiles.
SERPAPI_API_KEY=your_serpapi_api_key_here

# Send mail via Sign in with Google (Gmail API). Supabase Auth handles login,
# but the backend still uses this OAuth client to refresh Gmail provider tokens.
# Use the same Google OAuth client ID and secret in Supabase Auth.
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret

# Contact and feedback email.
NEXT_PUBLIC_CONTACT_EMAIL=
RESEND_API_KEY=
RESEND_FROM=Outreachyr <onboarding@resend.dev>

# Stripe one-time campaign unlock. Leave blank in local dev to skip billing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BILLING_ADMIN_EMAILS=geoffrey31415@gmail.com

# Protect the send-queue cron endpoint when used.
CRON_SECRET=

# Optional direct-run overrides. Docker Compose derives its own internal
# OUTREACH_API_URL, FRONTEND_URL, and FRONTEND_ORIGIN from the ports above.
# PUBLIC_APP_URL=http://localhost:3000
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# OUTREACH_API_URL=http://127.0.0.1:5050
